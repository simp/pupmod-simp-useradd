# This file managed by Puppet.
# Any changes will be overwritten at the next run.

<% if not @user_whitelist.empty? then -%>
for user in <%= @user_whitelist.join(' ') %>; do
  if [ "$USER" == "$user" ]; then
    return
  fi
done
<% end -%>
<% if @_session_timeout.is_a?(Integer) then -%>
[ $TMOUT ] || export TMOUT=<%= @_session_timeout * 60 %>
readonly TMOUT
<% end -%>
<% if ['y', 'n'].include?(@_mesg) then -%>

if tty -s; then
  mesg <%= @_mesg %>
fi
<% end -%>
<% unless [nil, 'absent'].include?(@umask) then -%>

umask <%= @umask %>
<% end -%>
